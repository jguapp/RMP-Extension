{
  "name": "rmp-extension",
  "version": "1.2.0",
  "private": true,
  "description": "Browser extension that surfaces Rate My Professors ratings, links and hover previews inside CUNYfirst Schedule Builder.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:dom": "node test/dom.integration.js",
    "test:all": "npm test && npm run test:dom",
    "check:api": "node tools/check-api.js",
    "build": "node tools/build.js",
    "icons": "node tools/make-icons.js",
    "screenshots": "node tools/make-screenshots.js"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
